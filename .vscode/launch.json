{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug NicManager (gdb, MSYS2)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "environment": [{ "name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}" }],
      "externalConsole": false
    },
    {
      "name": "Debug NicManager (MSVC build)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
