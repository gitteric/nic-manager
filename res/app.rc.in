// Generated from res/app.rc.in by CMake.
#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/res/resource.h"

1 24 "@CMAKE_CURRENT_BINARY_DIR@/app.manifest"

// First icon in the file: Explorer, shortcuts, taskbar and tray use it.
IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/res/app.ico"

// MAC address vendors for subnet scans, built from the IEEE registry.
IDR_OUI RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/res/oui.bin"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NIC Manager"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "NIC Manager"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "NicManager.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_HOST DIALOGEX 0, 0, 186, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit host"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Name", IDC_STATIC, 7, 7, 172, 9
    EDITTEXT        IDC_HOST_NAME, 7, 17, 172, 13, ES_AUTOHSCROLL
    LTEXT           "IPv4 address or host name", IDC_STATIC, 7, 35, 172, 9
    EDITTEXT        IDC_HOST, 7, 45, 172, 13, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Enable ping", IDC_HOST_PING, 7, 64, 172, 12
    DEFPUSHBUTTON   "OK", IDOK, 75, 85, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 129, 85, 50, 14
END

IDD_GROUP DIALOGEX 0, 0, 186, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit group"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Name", IDC_STATIC, 7, 7, 172, 9
    EDITTEXT        IDC_HOST_NAME, 7, 17, 172, 13, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Enable ping", IDC_HOST_PING, 7, 36, 172, 12
    DEFPUSHBUTTON   "OK", IDOK, 75, 53, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 129, 53, 50, 14
END

IDD_STARTTASK DIALOGEX 0, 0, 200, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Start without UAC prompt"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "NIC Manager registers a scheduled task that starts it with administrator rights, so Windows no longer asks each time. Start it through the task, e.g. with the desktop shortcut.", IDC_STATIC, 7, 7, 186, 36
    AUTOCHECKBOX    "Start automatically at logon (minimized)", IDC_AUTOSTART, 7, 48, 186, 12
    AUTOCHECKBOX    "Create a desktop shortcut", IDC_SHORTCUT, 7, 64, 186, 12
    DEFPUSHBUTTON   "OK", IDOK, 89, 91, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 91, 50, 14
END

IDD_PROMPT DIALOGEX 0, 0, 186, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NIC Manager"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "", IDC_PROMPT_LABEL, 7, 7, 172, 10
    EDITTEXT        IDC_PROMPT_EDIT, 7, 19, 172, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 75, 41, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 129, 41, 50, 14
END

IDD_ACTION DIALOGEX 0, 0, 186, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Host action"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Type", IDC_STATIC, 7, 7, 172, 9
    COMBOBOX        IDC_TYPE, 7, 17, 172, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Host", IDC_LBL_HOST, 7, 35, 172, 9
    EDITTEXT        IDC_HOST, 7, 45, 172, 13, ES_AUTOHSCROLL
    LTEXT           "Port", IDC_LBL_PORT, 7, 63, 40, 9
    EDITTEXT        IDC_PORT, 7, 73, 40, 13, ES_NUMBER
    LTEXT           "User", IDC_LBL_USER, 53, 63, 126, 9
    EDITTEXT        IDC_USER, 53, 73, 126, 13, ES_AUTOHSCROLL
    LTEXT           "Password", IDC_LBL_PASS, 7, 91, 172, 9
    EDITTEXT        IDC_PASS, 7, 101, 172, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Display", IDC_LBL_MODE, 7, 119, 172, 9
    COMBOBOX        IDC_MODE, 7, 129, 172, 40, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "TightVNC viewer (tvnviewer.exe, for all VNC actions)", IDC_LBL_VNC, 7, 119, 172, 9
    EDITTEXT        IDC_VNCPATH, 7, 129, 150, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE, 160, 129, 19, 13
    DEFPUSHBUTTON   "OK", IDOK, 75, 149, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 129, 149, 50, 14
END

IDD_PRESETS DIALOGEX 0, 0, 200, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IPv4 presets"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LISTBOX         IDC_PRESET_LIST, 7, 7, 130, 136, LBS_MULTIPLESEL | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Delete", IDC_DELETE, 143, 7, 50, 14
    PUSHBUTTON      "Export...", IDC_EXPORT, 143, 25, 50, 14
    PUSHBUTTON      "Import...", IDC_IMPORT, 143, 43, 50, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 143, 129, 50, 14
END

IDD_SCANRESULT DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Subnet scan"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "", IDC_SCAN_SUMMARY, 7, 7, 286, 10
    LISTBOX         IDC_SCAN_LIST, 7, 20, 286, 152, LBS_EXTENDEDSEL | LBS_USETABSTOPS | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add selected to ping list", IDC_ADD_SELECTED, 7, 179, 92, 14
    PUSHBUTTON      "Add all to ping list", IDC_ADD_ALL, 103, 179, 72, 14
    PUSHBUTTON      "Copy", IDC_COPY, 189, 179, 50, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 243, 179, 50, 14
END

